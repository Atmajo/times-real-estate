generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyTypes {
  Apartments
  Villas
  Townhouses
  Penthouses
  Lands
  Offices
  Mansions
  Duplex
  Warehouse
  Lofts
}

enum Status {
  Coming_Soon
  Offplan
  Ready_To_Move
  Resale
}

enum PropertyUserType {
  Individual
  Agent
  Investor
  Do_not_want_to_disclose
  Others
}

enum Usertype {
  AGENT
  ADMIN
  UNVERIFIED
}

enum Mode {
  OFFLINE
  ONLINE
}

enum Timeframe {
  MORNING
  AFTERNOON
  EVENING
  ANYTIME
}

model User {
  id          String        @id @default(cuid())
  image       String?
  name        String
  email       String        @unique
  password    String
  phone       String?
  address     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  collection  Collection[]
  requestTour RequestTour[]

  @@map("user")
}

model Collection {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  // Relations
  user       User     @relation(fields: [userId], references: [id])
  properties Property @relation(fields: [propertyId], references: [id])

  @@map("collection")
}

model RequestTour {
  id         String    @id @default(cuid())
  userId     String
  propertyId String
  mode       Mode
  date       DateTime
  timeframe  Timeframe
  name       String
  email      String
  message    String
  createdAt  DateTime  @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@map("requestTour")
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Usertype @default(UNVERIFIED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin")
}

model Developer {
  id          String @id @default(cuid())
  name        String
  description String

  // Relations
  properties Property[]

  @@map("developer")
}

model Area {
  id    String @id @default(cuid())
  image String
  name  String

  // Relations
  communities Community[]
  properties  Property[]

  @@map("area")
}

model Community {
  id          String @id @default(cuid())
  name        String
  description String
  areaId      String

  // Relations
  area       Area       @relation(fields: [areaId], references: [id])
  properties Property[]

  @@map("community")
}

model Accommodation {
  id    String @id @default(cuid())
  value String @unique

  // Relations
  properties Property[]

  @@map("accomodation")
}

model Possession {
  id    String @id @default(cuid())
  value String @unique

  // Relations
  properties Property[]

  @@map("possession")
}

model PaymentPlan {
  id    String @id @default(cuid())
  name  String
  value String

  // Relations
  properties Property[]

  @@map("paymentPlan")
}

model Property {
  id                  String        @id @default(cuid())
  developerId         String
  communityId         String
  images              String[]
  name                String
  overview            String
  status              Status
  type                PropertyTypes
  isFeatured          Boolean
  size                Float
  downPayment         Float
  paymentPlanId       String
  handover            DateTime
  featureAmenities    Json
  brochure            String // file link
  floorPlanBrochure   String // file link
  paymentPlanBrochure String // file link
  price               Float
  lat                 String
  long                String
  availableDates      DateTime[]
  createdAt           DateTime      @default(now())

  // Relations
  developer        Developer         @relation(fields: [developerId], references: [id])
  community        Community         @relation(fields: [communityId], references: [id])
  paymentPlan      PaymentPlan       @relation(fields: [paymentPlanId], references: [id])
  propertyContacts PropertyContact[]
  accommodation    Accommodation     @relation(fields: [accommodationId], references: [id])
  accommodationId  String
  possession       Possession        @relation(fields: [possessionId], references: [id])
  possessionId     String
  area             Area              @relation(fields: [areaId], references: [id])
  areaId           String
  collection       Collection[]
  requestTour      RequestTour[]

  @@map("properties")
}

model PropertyContact {
  id         String           @id @default(cuid())
  propertyId String           @unique
  name       String
  phone      String
  email      String
  type       PropertyUserType
  message    String

  // Relations
  property Property @relation(fields: [propertyId], references: [id])

  @@map("propertyContact")
}

model Contact {
  id      String @id @default(cuid())
  name    String
  phone   String
  email   String
  type    String
  message String

  @@map("contact")
}
